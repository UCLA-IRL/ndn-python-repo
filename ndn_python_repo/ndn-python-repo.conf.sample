---
repo_config:
  # the repo's routable prefix
  repo_name: 'testrepo'
  # if true, the repo registers the root prefix. If false, client needs to tell repo
  # which prefix to register/unregister
  register_root: False

# Direct ingest is disabled unless ingest_security is configured.
# Ingest command Interests are validated against an LVS trust schema, fetching the
# signing certificate chain up to the trust anchor. One CA trust anchor may authorize
# multiple producers through the LVS schema; their certificate chains must end at it.
# The trust anchor may be a binary or base64-encoded certificate. The trust schema is
# normally a compiled LVS binary schema; LVS text is also accepted and compiled at startup.
# Tilde and environment variables in both paths are expanded. A sample text schema is
# provided in ingest.lvs.sample.
# ingest_security:
#   trust_anchor: '~/.ndn/trust/trust-anchor.ndncert'
#   trust_schema: '/etc/ndn-python-repo/ingest.lvsb'

db_config:
  # choose one among sqlite3, leveldb, and mongodb
  db_type: 'sqlite3'
  
  # only the chosen db's config will be read
  sqlite3:
    'path': '~/.ndn/ndn-python-repo/sqlite3.db'   # filepath to sqlite3 database file
  leveldb:
    'dir': '~/.ndn/ndn-python-repo/leveldb/'      # directory to leveldb database files
  mongodb:
    'uri': 'mongodb://127.0.0.1:27017/'
    'db': 'repo'
    'collection': 'data'


tcp_bulk_insert:
  addr: '0.0.0.0'
  port: '7376'
  # when register_root is False, whether packets inserted via TCP triggers prefix registration
  register_prefix: True
  # One prefix in the list is used for registration if:
  # 1. register_root is False, and
  # 2. register_prefix is True, and
  # 3. the prefix matches the name of the sent data
  # If 1 and 2 but not 3, the full data name is used to register.
  prefixes:
  - '/test'


logging_config:
  # one of 'CRITICAL', 'ERROR', 'WARNING', 'INFO', 'DEBUG'
  level: 'INFO'
  # absolute path to log file. If not given, logs to stdout
  # file: 'repo.log'
